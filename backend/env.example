# API Configuration
API_TITLE=Microcontroller API Assistant
API_VERSION=0.1.0
API_DESCRIPTION=AI-powered tool for generating microcontroller API code

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=true

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Model Configuration
MODEL_NAME=microsoft/DialoGPT-medium
MODEL_PATH=
MAX_LENGTH=512
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50

# Feature Flags (Advanced Features)
# Set to 'true' to enable advanced features (default: false for stability)
ENABLE_VLLM=false
ENABLE_TRITON=false

# vLLM Configuration (requires ENABLE_VLLM=true)
VLLM_ENABLED=false
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=2048
VLLM_TRUST_REMOTE_CODE=true

# Triton Configuration (requires ENABLE_TRITON=true)
TRITON_ENABLED=false
TRITON_KERNEL_CACHE_DIR=

# Hugging Face Configuration
HF_TOKEN=your_huggingface_token_here
HF_CACHE_DIR=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} | {message}

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
